# Cloudflare Pages auto-strips .html, so all redirect targets below
# point to extensionless URLs to avoid 301 → 307 loops.

# Wix booking
/book-online                         /evaluation 301
/booking-calendar/free-evaluation-1  /evaluation 301
/booking-calendar/*                  /evaluation 301

# Wix legal pages (Wix slugs differ from ours, so these are real redirects)
/refund-policy           /refund 301
/terms-and-conditions    /terms 301
/privacy-policy          /privacy 301
/accessibility-statement /accessibility 301

# Wix contact (Wix used /contact-us, we use /contact)
/contact-us /contact 301

# NOTE: /about is NOT redirected — Wix used /about and we also use /about,
# so the file at /about.html serves it natively. Adding a redirect here
# would cause a loop with Cloudflare's auto-strip behavior.

